# Supabase (required for real auth / DB / file uploads)
# Leave empty to run demo mode (localStorage seed data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — UUID profile image API used by Tools → Image Finder
NEXT_PUBLIC_IMAGE_API_URL=https://api.uuonline.in/api/student/image

# Optional — enable Google in Supabase Auth → Providers (Client ID/Secret stay in Supabase).
# Then run supabase/patch_google_auth.sql. No Google keys needed in this .env.

# Web Push (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com
